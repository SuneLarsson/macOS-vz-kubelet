
# --- Registry Config ---
HARBOR_REGISTRY="<YOUR_REGISTRY>"
PROJECT_NAME="macos-images"
IMAGE_NAME="macos-thesis"
IMAGE_TAG="v1"

SSH_USER="thesis"
SSH_PASS="thesis"
VM_HOSTNAME="thesis.local"

MASTER_DISK="master-disk.img"
MASTER_AUX="master-aux.img"

# --- VM Settings ---
# The IPSW image
IPSW_NAME="mac15.2_restore.ipsw"
DISK_SIZE="64" # Size in GB

VM_CPU=4
VM_RAM_GB=8

# --- Packages To Install ---
# Homebrew packages to install
BREW_PACKAGES=(
    "python"
    "cmake"
    "fio"
)

# Pyhton (pip) packages will be installed with --break-system-packages
PIP_PACKAGES=(
    "torch"
    "torchvision"
    "mlx"
    "numpy"
    "pandas"
    "mlx-lm"
    "coremltools"
    "transformers"
    "accelerate"
    "torch-hd"
    "psutil"
    "tqdm"
)